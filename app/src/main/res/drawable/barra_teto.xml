<?xml version="1.0" encoding="utf-8"?>
<!-- barrinha da meta e do teto: fundo cinza claro, parte cheia verde (fica vermelha quando passa do teto) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="3dp" /><solid android:color="@color/trilho" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><corners android:radius="3dp" /><solid android:color="@color/primaria" /></shape></clip>
    </item>
</layer-list>
