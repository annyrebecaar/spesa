<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema do app. Sem ActionBar: cada tela coloca a própria Toolbar no layout. -->
    <style name="Theme.Spesa" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primaria</item>
        <item name="colorOnPrimary">@color/sobre_primaria</item>
        <item name="colorPrimaryContainer">@color/primaria_clara</item>
        <item name="colorOnPrimaryContainer">@color/primaria_escura</item>
        <item name="colorSecondary">@color/primaria</item>
        <item name="colorOnSecondary">@color/sobre_primaria</item>
        <item name="colorSecondaryContainer">@color/primaria_clara</item>
        <item name="colorOnSecondaryContainer">@color/primaria_escura</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="colorOnSurfaceVariant">@color/texto_suave</item>
        <item name="colorOutline">@color/borda</item>
        <!-- Superfícies de diálogos, menus e switches: sem o lilás padrão do Material 3 -->
        <item name="colorSurfaceContainerLow">@color/fundo</item>
        <item name="colorSurfaceContainer">@color/superficie</item>
        <item name="colorSurfaceContainerHigh">@color/superficie</item>
        <item name="colorSurfaceContainerHighest">@color/borda</item>
        <item name="colorSurfaceVariant">@color/borda</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:colorBackground">@color/fundo</item>
        <item name="android:statusBarColor">@color/fundo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/superficie</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Tela de abertura: fundo na cor principal -->
    <style name="Theme.Spesa.Splash" parent="Theme.Spesa">
        <item name="android:windowBackground">@color/primaria</item>
        <item name="android:statusBarColor">@color/primaria</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/primaria</item>
    </style>

    <!-- Estilos reaproveitados -->
    <style name="Spesa.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/fundo</item>
        <item name="titleTextColor">@color/texto</item>
        <item name="navigationIconTint">@color/texto</item>
    </style>

    <style name="Spesa.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/borda</item>
    </style>

    <style name="Spesa.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Spesa.Tag" parent="">
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/bg_tag</item>
    </style>
</resources>
