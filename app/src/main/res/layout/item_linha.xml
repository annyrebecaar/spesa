<?xml version="1.0" encoding="utf-8"?>
<!--
  Linha reaproveitada em várias telas (listas, lançamentos, lembretes, histórico).
  Cada tela mostra só as partes que precisa: barrinha colorida OU ícone OU caixinha de data.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp" style="@style/Spesa.Card" app:cardElevation="0dp"
    android:clickable="true" android:focusable="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:minHeight="64dp" android:orientation="horizontal"
        android:paddingStart="12dp" android:paddingTop="10dp" android:paddingEnd="12dp" android:paddingBottom="10dp">

        <View android:id="@+id/barra" android:layout_width="6dp" android:layout_height="match_parent"
            android:layout_marginEnd="12dp" android:background="@drawable/bg_barra" android:visibility="gone" />

        <FrameLayout android:id="@+id/caixaIcone" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginEnd="12dp" android:background="@drawable/bg_chip_icone" android:visibility="gone">
            <ImageView android:id="@+id/icone" android:layout_width="22dp" android:layout_height="22dp"
                android:layout_gravity="center" android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout android:id="@+id/caixaData" android:layout_width="44dp" android:layout_height="wrap_content"
            android:layout_marginEnd="12dp" android:background="@drawable/bg_chip_icone" android:gravity="center"
            android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/dataSemana" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/primaria" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/dataDia" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/fraunces_bold" app:fontFamily="@font/fraunces_bold" android:textColor="@color/primaria" android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/titulo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/texto" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/subtitulo" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/Spesa.Suave" android:textSize="12sp" />
            <ProgressBar android:id="@+id/progresso" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp"
                android:progressDrawable="@drawable/barra_orcamento" android:visibility="gone" />
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:gravity="end" android:orientation="vertical">
            <TextView android:id="@+id/valor" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/texto" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/extra" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/primaria" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>

        <ImageView android:id="@+id/seta" android:layout_width="20dp" android:layout_height="20dp"
            android:layout_marginStart="4dp" android:src="@drawable/ic_chevron_right"
            app:tint="@color/texto_suave" android:visibility="gone" android:contentDescription="@null" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
