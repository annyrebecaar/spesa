<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/fundo" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingStart="8dp" android:paddingTop="32dp" android:paddingEnd="8dp">
        <ImageButton android:id="@+id/voltar" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_chevron_left"
            app:tint="@color/texto" android:contentDescription="Voltar" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Minhas listas" android:textColor="@color/texto_suave" android:textSize="15sp" />
        <ImageButton android:id="@+id/editar" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_more"
            app:tint="@color/texto" android:contentDescription="Opções da pasta" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="12dp">
        <ImageView android:id="@+id/iconePasta" android:layout_width="52dp" android:layout_height="52dp"
            android:src="@drawable/ic_folder" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/nome" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textAppearance="@style/Spesa.Titulo" android:fontFamily="@font/fraunces_bold" app:fontFamily="@font/fraunces_bold" android:textColor="@color/texto" android:textSize="26sp" />
            <TextView android:id="@+id/resumo" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Spesa.Suave" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/listas" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" />
    </ScrollView>
    <TextView android:id="@+id/vazio" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:padding="24dp" android:text="Nenhuma lista nesta pasta ainda."
        android:textColor="@color/texto_suave" android:visibility="gone" />

    <com.google.android.material.button.MaterialButton android:id="@+id/novaLista" style="@style/Spesa.Botao"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="20dp"
        android:text="Nova lista nesta pasta" app:icon="@drawable/ic_plus" app:iconGravity="textStart" />
</LinearLayout>
