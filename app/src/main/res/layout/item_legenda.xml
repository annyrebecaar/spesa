<?xml version="1.0" encoding="utf-8"?>
<!-- legenda do gráfico: bolinha da cor, nome, % e valor -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
    <View android:id="@+id/cor" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_avatar" />
    <TextView android:id="@+id/nome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="8dp" android:textColor="@color/texto" android:textSize="14sp" />
    <TextView android:id="@+id/pct" android:layout_width="44dp" android:layout_height="wrap_content" android:gravity="end"
        android:textColor="@color/texto_suave" android:textSize="13sp" />
    <TextView android:id="@+id/valor" android:layout_width="110dp" android:layout_height="wrap_content" android:gravity="end"
        android:textColor="@color/texto" android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
