<?xml version="1.0" encoding="utf-8"?>
<!-- Desenho de uma pasta: orelha + fundo escuro + folha branca + frente colorida com o nome. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="100dp"
    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">

    <View android:id="@+id/orelha" android:layout_width="48dp" android:layout_height="20dp"
        android:background="@drawable/bg_pasta_orelha" />
    <View android:id="@+id/fundo" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginTop="8dp" android:background="@drawable/bg_pasta_fundo" />
    <View android:layout_width="match_parent" android:layout_height="28dp"
        android:layout_marginStart="10dp" android:layout_marginTop="15dp" android:layout_marginEnd="10dp"
        android:background="@drawable/bg_pasta_folha" />
    <LinearLayout android:id="@+id/frente" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginTop="28dp" android:background="@drawable/bg_pasta_frente"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="8dp"
        android:paddingEnd="12dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/nome" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:fontFamily="@font/fraunces_bold" app:fontFamily="@font/fraunces_bold" android:textSize="15sp"
            android:maxLines="2" android:ellipsize="end" android:textColor="@color/white" />
        <TextView android:id="@+id/quantas" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/white" />
    </LinearLayout>
</FrameLayout>
