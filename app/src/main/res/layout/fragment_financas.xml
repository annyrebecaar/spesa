<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fundo">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="20dp"
            android:paddingEnd="20dp" android:paddingBottom="96dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Finanças" android:textAppearance="@style/Spesa.Titulo" android:fontFamily="@font/fraunces_bold" app:fontFamily="@font/fraunces_bold" android:textColor="@color/texto" android:textSize="28sp" />
                <ImageButton android:id="@+id/anterior" android:layout_width="40dp" android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_chevron_left"
                    app:tint="@color/texto" android:contentDescription="Anterior" />
                <TextView android:id="@+id/periodo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="80dp" android:gravity="center" android:textStyle="bold" android:textSize="14sp" />
                <ImageButton android:id="@+id/proximo" android:layout_width="40dp" android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_chevron_right"
                    app:tint="@color/texto" android:contentDescription="Próximo" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/escala"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/escalaMes">
                <com.google.android.material.button.MaterialButton android:id="@+id/escalaDia" style="@style/Spesa.Segmento"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Dia" />
                <com.google.android.material.button.MaterialButton android:id="@+id/escalaSemana" style="@style/Spesa.Segmento"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Semana" />
                <com.google.android.material.button.MaterialButton android:id="@+id/escalaMes" style="@style/Spesa.Segmento"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mês" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Cartão verde: quanto sobrou, entrou e saiu -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:background="@drawable/bg_saldo" android:orientation="vertical" android:padding="18dp">
                <TextView android:id="@+id/rotuloSobrou" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sobrou no mês" android:textColor="@color/sobre_primaria_suave" android:textSize="13sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:id="@+id/sobrou" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:fontFamily="@font/fraunces_bold" app:fontFamily="@font/fraunces_bold" android:textColor="@color/creme_fixo" android:textSize="30sp" />
                    <TextView android:id="@+id/pctRenda" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_saldo_bloco" android:paddingStart="10dp" android:paddingTop="4dp"
                        android:paddingEnd="10dp" android:paddingBottom="4dp" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="6dp" android:background="@drawable/bg_saldo_bloco" android:orientation="vertical" android:padding="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entrou" android:textColor="@color/sobre_primaria_suave" android:textSize="12sp" />
                        <TextView android:id="@+id/entrou" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="6dp" android:background="@drawable/bg_saldo_bloco" android:orientation="vertical" android:padding="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Saiu" android:textColor="@color/sobre_primaria_suave" android:textSize="12sp" />
                        <TextView android:id="@+id/saiu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- quanto saiu hoje, na semana e no mês (sempre aparece, não importa a aba) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
                <LinearLayout style="@style/Spesa.CaixaSaiu">
                    <TextView style="@style/Spesa.CaixaSaiu.Rotulo" android:text="Saiu hoje" />
                    <TextView android:id="@+id/saiuHoje" style="@style/Spesa.CaixaSaiu.Valor" />
                </LinearLayout>
                <LinearLayout style="@style/Spesa.CaixaSaiu" android:layout_marginStart="8dp" android:layout_marginEnd="8dp">
                    <TextView style="@style/Spesa.CaixaSaiu.Rotulo" android:text="Na semana" />
                    <TextView android:id="@+id/saiuSemana" style="@style/Spesa.CaixaSaiu.Valor" />
                </LinearLayout>
                <LinearLayout style="@style/Spesa.CaixaSaiu">
                    <TextView style="@style/Spesa.CaixaSaiu.Rotulo" android:text="No mês" />
                    <TextView android:id="@+id/saiuMes" style="@style/Spesa.CaixaSaiu.Valor" />
                </LinearLayout>
            </LinearLayout>

            <!-- contas que vêm da agenda (lembretes de "Pagar") -->
            <!-- meta de economia do mês: toque para mudar -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" android:text="Meta de economia" style="@style/Spesa.Secao" />
            <com.google.android.material.card.MaterialCardView android:id="@+id/cartaoMeta" android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="14dp" app:strokeColor="@color/borda" app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/superficie">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:id="@+id/tituloMeta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:textColor="@color/texto" android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:id="@+id/pctMeta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/primaria" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                    <ProgressBar android:id="@+id/barraMeta" style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="10dp"
                        android:max="100" android:progressDrawable="@drawable/barra_teto" />
                    <TextView android:id="@+id/textoMeta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" style="@style/Spesa.Suave" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:gravity="bottom">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="A pagar" style="@style/Spesa.Secao" />
                <TextView android:id="@+id/totalAPagar" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Spesa.Suave" />
            </LinearLayout>
            <LinearLayout android:id="@+id/aPagar" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_card_cantos" android:clipToOutline="true" android:orientation="vertical" />
            <TextView android:id="@+id/aPagarVazio" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/Spesa.Suave" android:text="Nenhuma conta nos próximos 30 dias. Crie em Agenda > Lembrete > Pagar." />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" android:text="Para onde foi o dinheiro" style="@style/Spesa.Secao" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                style="@style/Spesa.Suave" android:text="Toque numa categoria para definir um teto de gasto no mês." />
            <!-- uma barra só, dividida pelas categorias -->
            <LinearLayout android:id="@+id/barraEmpilhada" android:layout_width="match_parent" android:layout_height="14dp"
                android:background="@drawable/bg_trilho" android:clipToOutline="true" android:orientation="horizontal" />
            <LinearLayout android:id="@+id/categorias" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="vertical" />

            <!-- planilha: tudo que entrou e saiu no período -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:gravity="bottom">
                <TextView android:id="@+id/tituloPlanilha" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Planilha do mês" style="@style/Spesa.Secao" />
                <TextView android:id="@+id/exportar" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:padding="4dp" android:text="Exportar" android:textColor="@color/primaria" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_card_cantos" android:clipToOutline="true" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/trilho"
                    android:paddingStart="10dp" android:paddingTop="8dp" android:paddingEnd="10dp" android:paddingBottom="8dp">
                    <TextView style="@style/Spesa.Coluna" android:layout_width="48dp" android:text="DIA" />
                    <TextView style="@style/Spesa.Coluna" android:layout_width="0dp" android:layout_weight="1" android:text="DESCRIÇÃO" />
                    <TextView style="@style/Spesa.Coluna" android:layout_width="78dp" android:gravity="end" android:text="ENTROU" />
                    <TextView style="@style/Spesa.Coluna" android:layout_width="78dp" android:gravity="end" android:text="SAIU" />
                </LinearLayout>
                <LinearLayout android:id="@+id/lancamentos" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <TextView android:id="@+id/vazio" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="14dp" android:gravity="center" style="@style/Spesa.Suave" android:text="Nenhum lançamento neste período. Toque em Lançar." />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/creme"
                    android:paddingStart="10dp" android:paddingTop="10dp" android:paddingEnd="10dp" android:paddingBottom="10dp">
                    <TextView android:layout_width="48dp" android:layout_height="wrap_content" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total" android:textColor="@color/texto" android:textStyle="bold" />
                    <TextView android:id="@+id/totalEntrou" android:layout_width="78dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/entrada" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/totalSaiu" android:layout_width="78dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/promo" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/primaria"
                    android:paddingStart="10dp" android:paddingTop="10dp" android:paddingEnd="10dp" android:paddingBottom="10dp">
                    <TextView android:id="@+id/rotuloSaldo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Saldo do mês" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/saldo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton android:id="@+id/lancar"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end"
        android:layout_margin="20dp" android:text="Lançar" android:textAllCaps="false" android:textStyle="bold"
        app:icon="@drawable/ic_plus" app:iconTint="@color/white" android:textColor="@color/white" app:backgroundTint="@color/primaria" />
</FrameLayout>
