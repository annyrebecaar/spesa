<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fundo">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="20dp"
            android:paddingEnd="20dp" android:paddingBottom="96dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Finanças" android:textAppearance="@style/Spesa.Titulo" android:fontFamily="@font/fraunces_bold" app:fontFamily="@font/fraunces_bold" android:textColor="@color/texto" android:textSize="28sp" />
                <ImageButton android:id="@+id/anterior" android:layout_width="40dp" android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_chevron_left"
                    app:tint="@color/texto" android:contentDescription="Anterior" />
                <TextView android:id="@+id/periodo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="80dp" android:gravity="center" android:textStyle="bold" android:textSize="14sp" />
                <ImageButton android:id="@+id/proximo" android:layout_width="40dp" android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_chevron_right"
                    app:tint="@color/texto" android:contentDescription="Próximo" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/escala"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/escalaMes">
                <com.google.android.material.button.MaterialButton android:id="@+id/escalaDia" style="@style/Spesa.Segmento"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Dia" />
                <com.google.android.material.button.MaterialButton android:id="@+id/escalaSemana" style="@style/Spesa.Segmento"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Semana" />
                <com.google.android.material.button.MaterialButton android:id="@+id/escalaMes" style="@style/Spesa.Segmento"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mês" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Cartão verde: quanto sobrou, entrou e saiu -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:background="@drawable/bg_saldo" android:orientation="vertical" android:padding="18dp">
                <TextView android:id="@+id/rotuloSobrou" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sobrou no mês" android:textColor="@color/sobre_primaria_suave" android:textSize="13sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:id="@+id/sobrou" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:fontFamily="@font/fraunces_bold" app:fontFamily="@font/fraunces_bold" android:textColor="@color/creme" android:textSize="30sp" />
                    <TextView android:id="@+id/pctRenda" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_saldo_bloco" android:paddingStart="10dp" android:paddingTop="4dp"
                        android:paddingEnd="10dp" android:paddingBottom="4dp" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginEnd="6dp" android:background="@drawable/bg_saldo_bloco" android:orientation="vertical" android:padding="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entrou" android:textColor="@color/sobre_primaria_suave" android:textSize="12sp" />
                        <TextView android:id="@+id/entrou" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="6dp" android:background="@drawable/bg_saldo_bloco" android:orientation="vertical" android:padding="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Saiu" android:textColor="@color/sobre_primaria_suave" android:textSize="12sp" />
                        <TextView android:id="@+id/saiu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" android:text="Para onde foi o dinheiro" style="@style/Spesa.Secao" />
            <LinearLayout android:id="@+id/categorias" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" android:text="Últimos lançamentos" style="@style/Spesa.Secao" />
            <LinearLayout android:id="@+id/lancamentos" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/vazio" android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/Spesa.Suave" android:text="Nenhum lançamento neste período. Toque em Lançar." />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton android:id="@+id/lancar"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end"
        android:layout_margin="20dp" android:text="Lançar" android:textAllCaps="false" android:textStyle="bold"
        app:icon="@drawable/ic_plus" app:iconTint="@color/white" android:textColor="@color/white" app:backgroundTint="@color/primaria" />
</FrameLayout>
