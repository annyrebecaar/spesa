<?xml version="1.0" encoding="utf-8"?>
<!-- Um dia do calendário: o número e, embaixo, uma bolinha se tiver compromisso -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
    android:gravity="center" android:orientation="vertical">
    <TextView android:id="@+id/numero" android:layout_width="36dp" android:layout_height="36dp"
        android:gravity="center" android:textSize="15sp" />
    <View android:id="@+id/ponto" android:layout_width="5dp" android:layout_height="5dp"
        android:background="@drawable/bg_avatar" android:visibility="invisible" />
</LinearLayout>
