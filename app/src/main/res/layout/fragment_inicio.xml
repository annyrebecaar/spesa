<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fundo">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <!-- Cabeçalho: inicial do nome, data e saudação -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/avatar" android:layout_width="44dp" android:layout_height="44dp"
                android:background="@drawable/bg_avatar" android:fontFamily="@font/fraunces_bold" app:fontFamily="@font/fraunces_bold" android:gravity="center"
                android:textColor="@color/creme" android:textSize="20sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:id="@+id/hoje" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Spesa.Suave" />
                <TextView android:id="@+id/ola" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textAppearance="@style/Spesa.Titulo" android:fontFamily="@font/fraunces_bold" app:fontFamily="@font/fraunces_bold" android:textColor="@color/texto" android:textSize="23sp" />
            </LinearLayout>
            <ImageButton android:id="@+id/sino" android:layout_width="44dp" android:layout_height="44dp"
                android:background="@drawable/bg_borda_redonda" android:src="@drawable/ic_bell"
                app:tint="@color/texto" android:contentDescription="Lembretes" />
        </LinearLayout>

        <!-- Saldo compacto: toca e vai para Finanças -->
        <LinearLayout android:id="@+id/cartaoSaldo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:background="@drawable/bg_saldo_18" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="12dp"
            android:paddingEnd="12dp" android:paddingBottom="12dp" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/rotuloSaldo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/sobre_primaria_suave" android:textSize="12sp" />
                <TextView android:id="@+id/saldo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="@font/fraunces_bold" app:fontFamily="@font/fraunces_bold" android:textColor="@color/creme" android:textSize="24sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Finanças"
                android:textColor="@color/sobre_primaria_suave" android:textSize="13sp" android:textStyle="bold"
                android:drawableEnd="@drawable/ic_chevron_right" android:drawableTint="@color/sobre_primaria_suave" />
        </LinearLayout>

        <!-- Atalhos -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal">
            <TextView android:id="@+id/atalhoLista" style="@style/Spesa.Atalho" android:text="Nova lista" android:drawableTop="@drawable/ic_plus" />
            <TextView android:id="@+id/atalhoGasto" style="@style/Spesa.Atalho" android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp" android:text="Lançar gasto" android:drawableTop="@drawable/ic_wallet" />
            <TextView android:id="@+id/atalhoContinuar" style="@style/Spesa.Atalho" android:text="Continuar lista" android:drawableTop="@drawable/ic_cart" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Na agenda" style="@style/Spesa.Secao" />
            <TextView android:id="@+id/verAgenda" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Ver agenda" android:textColor="@color/primaria" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/agenda" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/agendaVazia" android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Spesa.Suave" android:text="Nada marcado. Toque em Ver agenda para criar um lembrete." />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:layout_marginBottom="8dp" android:text="Atividade recente" style="@style/Spesa.Secao" />
        <LinearLayout android:id="@+id/atividades" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/atividadesVazia" android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Spesa.Suave" android:text="O que você fizer no app aparece aqui." />
    </LinearLayout>
</ScrollView>
