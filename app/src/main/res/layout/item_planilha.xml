<?xml version="1.0" encoding="utf-8"?>
<!-- uma linha da planilha: dia | descrição e categoria | entrou | saiu -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_linha_item" android:gravity="center_vertical"
    android:paddingStart="10dp" android:paddingTop="8dp" android:paddingEnd="10dp" android:paddingBottom="8dp">
    <TextView android:id="@+id/dia" android:layout_width="48dp" android:layout_height="wrap_content"
        android:textColor="@color/texto_suave" android:textSize="13sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/descricao" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/texto" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/categoria" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/texto_suave" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/entrou" android:layout_width="78dp" android:layout_height="wrap_content"
        android:gravity="end" android:textColor="@color/entrada" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/saiu" android:layout_width="78dp" android:layout_height="wrap_content"
        android:gravity="end" android:textColor="@color/promo" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>
