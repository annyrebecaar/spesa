<?xml version="1.0" encoding="utf-8"?>
<!-- uma linha de item, no mesmo jeito da Feira Semanal: bolinha, nome, quantidade × preço e total -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_linha_item" android:gravity="center_vertical"
    android:minHeight="60dp" android:orientation="horizontal"
    android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="14dp" android:paddingBottom="6dp">

    <CheckBox android:id="@+id/marcado" android:layout_width="44dp" android:layout_height="44dp"
        android:button="@drawable/check_circulo" android:background="@null"
        app:buttonTint="@null" app:useMaterialThemeColors="false" app:buttonIconTint="@null" android:gravity="center"
        android:contentDescription="Já peguei" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="4dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/nome" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="2" android:textColor="@color/texto" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/tagPromo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:background="@drawable/bg_promo_amarelo" android:paddingStart="6dp"
                android:paddingEnd="6dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:text="PROMO"
                android:textColor="@color/texto" android:textSize="10sp" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/detalhe" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/texto_suave" android:textSize="13sp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp">
            <TextView android:id="@+id/tagCategoria" style="@style/Spesa.Tag" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/mercado" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:textColor="@color/texto_suave" android:textSize="12sp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/total" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:textColor="@color/texto" android:textSize="15sp" android:textStyle="bold" />
</LinearLayout>
