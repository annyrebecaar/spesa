<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Para mostrar as notificações dos lembretes (Android 13+ pede ao usuário) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Spesa">

        <!-- Tela de abertura: é a que o celular abre primeiro (LAUNCHER) -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Spesa.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.MainActivity" android:exported="false" android:windowSoftInputMode="adjustPan" />
        <activity android:name=".ui.ListaActivity" android:exported="false" />
        <activity android:name=".ui.ItemFormActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.MercadosActivity" android:exported="false" />
        <activity android:name=".ui.ProdutosActivity" android:exported="false" />
        <activity android:name=".ui.ProdutoFormActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ComparativoActivity" android:exported="false" />
        <activity android:name=".ui.LoginActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.CadastroActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.PastaActivity" android:exported="false" />
        <activity android:name=".ui.LancamentoFormActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.LembreteFormActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- Recebe a hora do aviso de um lembrete e mostra a notificação -->
        <receiver android:name=".util.AvisoReceiver" android:exported="false" />
    </application>

</manifest>
